EXPO_PUBLIC_API_URL=http://localhost:5000

# Client ID de tipo Web (OAuth 2.0) de Google Cloud Console.
# NO uses el Client ID de tipo Android: eso causa DEVELOPER_ERROR.
# El mismo valor va en GOOGLE_CLIENT_ID de la API.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Opcional, solo iOS. Client ID de tipo iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
