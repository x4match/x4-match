# Copiar a .env en local. En Render: Environment → Add variables.

# --- Obligatorias ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# URL pública de esta API (Render: https://x4-match-api.onrender.com o dominio custom)
API_PUBLIC_URL=http://localhost:5000

# Render asigna PORT automáticamente; en local podés fijarlo:
PORT=5000
NODE_ENV=development

# --- Cloudinary (subida de fotos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Pagos (opcional en staging) ---
PAYMENTS_MOCK=true
MERCADOPAGO_ACCESS_TOKEN=
MP_APP_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=

# --- Mobile deep links (OAuth Mercado Pago) ---
MOBILE_APP_SCHEME=playtomic
WEB_CLUB_URL=http://localhost:3001

# --- No definir en Render (solo Vercel serverless) ---
# VERCEL=
