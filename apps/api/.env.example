# Copiar a .env en local.
# Prod EC2: ver infra/aws/env.example + setup-ec2.sh (DB en Neon).

# --- Obligatorias ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# URL pública de esta API (EC2+Caddy: https://api.tudominio.com)
API_PUBLIC_URL=http://localhost:5000

# En EC2/systemd usá PORT=5000; Caddy hace HTTPS en 443.
PORT=5000
NODE_ENV=development

# --- Cloudinary (subida de fotos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Pagos clubes (OAuth marketplace) ---
# La app en MP Developers debe llamarse "x4 match" y usar modelo Marketplace.
# Collector de señas/torneos/tienda = cuenta MP de CADA CLUB (token OAuth).
# No poner acá el access token personal/puente como collector en prod.
PAYMENTS_MOCK=true
MERCADOPAGO_ACCESS_TOKEN=
MP_APP_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
# Cifrado de tokens OAuth de clubes en DB
PAYMENT_TOKEN_ENCRYPTION_KEY=

# --- Cobro suscripción plan Club (cuenta SAS / sociedad; fuera de iOS) ---
# Link de pago / suscripción MP de x4 match. No usar para checkouts de jugadores.
X4MATCH_BILLING_MP_ACCESS_TOKEN=

# --- Mobile deep links (OAuth Mercado Pago) ---
# Debe coincidir con "scheme" en apps/mobile/app.json (= x4match).
# Si usás playtomic u otro, Safari falla al volver del OAuth.
MOBILE_APP_SCHEME=x4match
WEB_CLUB_URL=http://localhost:3001

# --- Google Sign-In (OAuth 2.0 Client IDs de Google Cloud Console) ---
# Web client ID (obligatorio; también lo usa la app móvil como webClientId)
GOOGLE_CLIENT_ID=
# Opcional: client IDs nativos para validar tokens de iOS/Android
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Sign in with Apple (audience del identity token = Bundle ID) ---
APPLE_BUNDLE_ID=com.x4match.app

# --- No definir en EC2 (solo Vercel serverless) ---
# VERCEL=
