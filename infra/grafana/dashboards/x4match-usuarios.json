    {
      "id": 12,
      "type": "table",
      "title": "Quién usa la app (último acceso)",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_X4_NEON}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_X4_NEON}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT u.name AS \"Nombre\", u.email AS \"Email\", u.role::text AS \"Rol\",\n       u.last_seen_at AS \"Último acceso\", u.last_platform AS \"Plataforma\", u.last_app_version AS \"Versión\",\n       coalesce(a.days, 0) AS \"Días activo (30d)\", coalesce(a.requests, 0) AS \"Requests (30d)\",\n       u.created_at AS \"Alta\"\nFROM users u\nLEFT JOIN (\n  SELECT user_id, count(DISTINCT day) AS days, sum(requests) AS requests\n  FROM user_activity_daily\n  WHERE day > (now() AT TIME ZONE 'America/Argentina/Buenos_Aires')::date - 30\n  GROUP BY user_id\n) a ON a.user_id = u.id\nWHERE u.last_seen_at IS NOT NULL\nORDER BY u.last_seen_at DESC\nLIMIT 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": []
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Más activos (30 días)",
      "gridPos": {
