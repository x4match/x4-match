          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT u.name AS \"Nombre\", u.email AS \"Email\", count(DISTINCT a.day) AS \"Días activo\", sum(a.requests) AS \"Requests\",\n       string_agg(DISTINCT a.platform, ', ') AS \"Plataformas\"\nFROM user_activity_daily a\nJOIN users u ON u.id = a.user_id\nWHERE a.day > (now() AT TIME ZONE 'America/Argentina/Buenos_Aires')::date - 30\nGROUP BY u.id, u.name, u.email\nORDER BY 3 DESC, 4 DESC\nLIMIT 25"
        }
      ],
