    {
      "id": 15,
      "type": "table",
      "title": "Retención semanal por cohorte de alta",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_X4_NEON}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_X4_NEON}"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH cohort AS (\n  SELECT id AS user_id, date_trunc('week', created_at AT TIME ZONE 'America/Argentina/Buenos_Aires')::date AS week\n  FROM users\n  WHERE created_at > now() - interval '12 weeks'\n), activity AS (\n  SELECT DISTINCT user_id, date_trunc('week', day)::date AS week FROM user_activity_daily\n)\nSELECT c.week AS \"Semana de alta\",\n       count(DISTINCT c.user_id) AS \"Altas\",\n       round(100.0 * count(DISTINCT a.user_id) FILTER (WHERE a.week = c.week) / count(DISTINCT c.user_id), 1) AS \"Semana 0 %\",\n       round(100.0 * count(DISTINCT a.user_id) FILTER (WHERE a.week = c.week + 7) / count(DISTINCT c.user_id), 1) AS \"Semana 1 %\",\n       round(100.0 * count(DISTINCT a.user_id) FILTER (WHERE a.week = c.week + 14) / count(DISTINCT c.user_id), 1) AS \"Semana 2 %\",\n       round(100.0 * count(DISTINCT a.user_id) FILTER (WHERE a.week = c.week + 28) / count(DISTINCT c.user_id), 1) AS \"Semana 4 %\"\nFROM cohort c\nLEFT JOIN activity a ON a.user_id = c.user_id\nGROUP BY c.week\nORDER BY c.week DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
