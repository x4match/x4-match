      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_X4_PROMETHEUS}"
          },
          "expr": "sum(rate(x4_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(x4_http_requests_total[5m]))",
          "legendFormat": "",
          "refId": "A"
