          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT c.name AS \"Club\", c.city AS \"Ciudad\", count(m.id) AS \"Partidos\"\nFROM matches m\nJOIN clubs c ON c.id = m.club_id\nWHERE $__timeFilter(m.created_at)\nGROUP BY c.id, c.name, c.city\nORDER BY 3 DESC\nLIMIT 15"
        }
