# Copiar a /opt/x4match/apps/api/.env en la EC2 (chmod 600).
# DB: Neon (no RDS). API: esta máquina.

NODE_ENV=production
PORT=5000

# Neon connection string (sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

JWT_SECRET=cambiar-por-secreto-largo-aleatorio
JWT_EXPIRES_IN=7d

# Dominio público HTTPS de esta EC2 (Caddy). Ej: https://api.tudominio.com
API_PUBLIC_URL=https://api.tudominio.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago — redirect URI en MP Developers = misma URL:
#   {API_PUBLIC_URL}/clubs/oauth/mercadopago/callback
#   {API_PUBLIC_URL}/sponsors/oauth/mercadopago/callback
PAYMENTS_MOCK=false
MERCADOPAGO_ACCESS_TOKEN=
MP_APP_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://api.tudominio.com/clubs/oauth/mercadopago/callback
MP_SPONSOR_REDIRECT_URI=https://api.tudominio.com/sponsors/oauth/mercadopago/callback
PAYMENT_TOKEN_ENCRYPTION_KEY=
X4MATCH_BILLING_MP_ACCESS_TOKEN=

# Deep link — DEBE ser x4match (apps/mobile/app.json). Si queda playtomic,
# Safari muestra "dirección no válida" al volver del OAuth de Mercado Pago.
MOBILE_APP_SCHEME=x4match
WEB_CLUB_URL=https://club.tudominio.com
WEB_SPONSORS_PUBLIC_URL=https://sponsor.tudominio.com
WEB_SPONSORS_HOST=sponsor.tudominio.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple (audience = Bundle ID)
APPLE_BUNDLE_ID=com.x4match.app
APPLE_SERVICES_ID=

# No definir VERCEL= en EC2
